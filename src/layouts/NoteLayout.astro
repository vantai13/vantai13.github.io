---
import BaseLayout from './BaseLayout.astro';
interface Props { frontmatter: { title: string; description: string; category: string; date: string; }; }
const { frontmatter } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} — Doan Van Tai`} description={frontmatter.description} article><div class="container page-header"><a class="breadcrumb" href="/writing/">← All writing & notes</a><p class="eyebrow">{frontmatter.category}</p><h1>{frontmatter.title}</h1><div class="note-meta"><span>Doan Van Tai</span><time datetime={frontmatter.date}>{new Date(frontmatter.date).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time></div></div><div class="container"><article class="note-layout"><p class="note-intro">A working note drawn from the project documentation. This is an explanatory note, not a peer-reviewed publication.</p><div class="prose"><slot/></div></article></div></BaseLayout>
