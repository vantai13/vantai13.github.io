---
import Icon from './Icon.astro';
import NetworkFigure from './NetworkFigure.astro';
import type { Work } from '../data/work';
interface Props { project: Work; headingLevel?: 2 | 3; }
const { project, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---
<article class="project-card" data-project-category={project.kind}>
  <a href={`/work/${project.slug}/`} class:list={['project-image', { 'cloud-image': project.slug === 'cloud-gitops' }]} aria-label={`Read ${project.shortTitle}`}>
    {project.image ? <img src={project.image} alt={project.imageAlt} loading="lazy" width="1200" height="750" /> : <NetworkFigure variant={project.slug === 'state-model-regret' ? 'research' : 'routing'} />}
    <span class="image-link-icon"><Icon /></span>
  </a>
  <div class="project-card-content">
    <div class="work-meta"><span class="pill">{project.status}</span><span>{project.period}</span></div>
    <Heading class="project-card-title"><a href={`/work/${project.slug}/`}>{project.shortTitle}</a></Heading>
    <p>{project.summary}</p>
    {project.advisor && <p class="project-advisor">Research Advisor: <a href={project.advisor.homepage} target="_blank" rel="noopener noreferrer">{project.advisor.name}</a></p>}
    <div class="stack-tags">{project.tags.slice(0, 3).map(tag => <span>{tag}</span>)}</div>
    <a class="text-link" href={`/work/${project.slug}/`}>Read the project <Icon name="arrow-right" size={16} /></a>
  </div>
</article>
