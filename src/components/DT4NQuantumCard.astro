---
import Icon from './Icon.astro';
import NetworkTwinVisual from './NetworkTwinVisual.astro';
import { researchAdvisor } from '../data/profile';
import { work } from '../data/work';
interface Props { id?: string; }
const { id = 'dt4n-featured' } = Astro.props;
const project = work.find(item => item.slug === 'network-digital-twin')!;
---
<article class="featured-research dt4n-quantum-card" aria-labelledby={`${id}-title`}>
  <div class="dt4n-copy">
    <div class="dt4n-kicker"><span>FEATURED RESEARCH</span><span>{project.period}</span></div>
    <h3 id={`${id}-title`}>Network <em>Digital Twin</em> for Intelligent Network Management</h3>
    <p>I built a synchronized SDN testbed and digital representation for monitoring, what-if analysis, anomaly detection, and closed-loop control.</p>
    <p class="dt4n-role">Project Lead · Built with Mininet, Ryu, and Eclipse Ditto.</p>
    <p class="dt4n-advisor">Supervised by <a href={researchAdvisor.homepage} target="_blank" rel="noopener noreferrer">{researchAdvisor.name}</a> · UIT, VNU-HCM</p>
    <div class="dt4n-tags"><span>SDN</span><span>Digital Twin</span><span>What-if Analysis</span><span>Closed-loop Control</span></div>
    <div class="dt4n-actions"><a class="button dt4n-primary" href="/work/network-digital-twin/">View project <Icon name="arrow-right" size={16} /></a><a class="text-link" href="/work/network-digital-twin/#methodology">See methodology <Icon name="arrow-right" size={16} /></a></div>
  </div>
  <NetworkTwinVisual id={`${id}-visual`} />
</article>

<style>
  .dt4n-quantum-card { grid-template-columns:1fr 1.05fr; gap:42px; position:relative; padding:42px; background:radial-gradient(ellipse at 80% 30%,#16393270,transparent 60%),linear-gradient(135deg,#0b1418,#101e22); border:1px solid #76f2df2e; border-radius:16px; box-shadow:0 18px 46px #0b201914,inset 0 1px #ffffff08; color:#eaf6f3; }
  .dt4n-copy { min-width:0; }
  .dt4n-kicker { display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px; margin-bottom:22px; font-size:9px; letter-spacing:1.6px; color:#a0d9cc; }
  .dt4n-kicker>span:last-child { letter-spacing:.3px; color:#abc4be; }
  .dt4n-copy h3 { font-family:var(--serif); font-size:clamp(33px,3.1vw,45px); font-weight:400; line-height:1.1; letter-spacing:-.8px; }
  .dt4n-copy h3 em { color:#76e4cf; }
  .dt4n-copy>p { margin-top:22px; color:#c5d8d3; font-size:14px; line-height:1.85; }
  .dt4n-copy>.dt4n-role,.dt4n-copy>.dt4n-advisor { margin-top:15px; font-size:12px; }
  .dt4n-advisor a { color:#a4f1dd; text-decoration:underline; text-underline-offset:3px; }
  .dt4n-tags { display:flex; flex-wrap:wrap; gap:8px; margin-top:24px; }
  .dt4n-tags>span { padding:5px 9px; border:1px solid #76f2df24; border-radius:5px; color:#c2e8dc; background:#ffffff03; font-size:10px; }
  .dt4n-actions { display:flex; flex-wrap:wrap; align-items:center; gap:20px; margin-top:28px; }
  .dt4n-primary { background:#96e5ce; color:#102c25; border:1px solid #96e5ce; }
  .dt4n-primary:hover { background:#bef5e4; }
  .dt4n-actions>.text-link { color:#b3efdf; }
  .dt4n-quantum-card :global(a:focus-visible),.dt4n-quantum-card :global(button:focus-visible) { outline-color:#b3efdf; }
  @media(max-width:1000px) { .dt4n-quantum-card { grid-template-columns:1fr; gap:30px; padding:32px; } .dt4n-copy h3 { max-width:620px; font-size:40px; } .dt4n-quantum-card :global(.ndt-visual) { width:min(100%,500px); justify-self:center; } }
  @media(max-width:720px) { .dt4n-quantum-card { padding:24px 20px 15px; gap:28px; border-radius:12px; } .dt4n-copy h3 { font-size:35px; } .dt4n-copy>p { font-size:13px; } .dt4n-actions { gap:15px; } .dt4n-actions>.text-link { font-size:11px; } }
</style>
