---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import NetworkFigure from '../../components/NetworkFigure.astro';
import { work, type Work } from '../../data/work';
export function getStaticPaths() { return work.map(project=>({params:{slug:project.slug},props:{project}})); }
interface Props { project: Work; }
const { project } = Astro.props;
const related = work.filter(item => item.kind === project.kind);
const next = related[(related.findIndex(item => item.slug === project.slug) + 1) % related.length];
const overview = project.kind === 'research' ? { href: '/research/', label: 'Research' } : { href: '/projects/', label: 'Engineering projects' };
---
<BaseLayout title={`${project.shortTitle} — Doan Van Tai`} description={project.summary} article activeSection={project.kind === 'research' ? 'research' : 'projects'}>
  <div class="container page-header"><a class="breadcrumb" href={overview.href}>← {overview.label}</a><p class="eyebrow">{project.index} / {project.category}</p><h1>{project.title}</h1><p class="page-description">{project.summary}</p><div class="work-header-meta"><span class="pill">{project.status}</span><span>{project.period}</span></div></div>
  <div class="container page-body">
    {project.image?<img class="case-hero-image" src={project.image} alt={project.imageAlt} width="1200" height="700"/>:<div class="case-hero-image"><NetworkFigure variant={project.slug==='state-model-regret'?'research':'routing'}/></div>}
    <div class="case-layout"><aside class="case-sidebar" aria-label="Project resources"><span class="small-label">TECHNOLOGIES & TOPICS</span><div class="stack-tags">{project.tags.map(tag=><span>{tag}</span>)}</div><span class="small-label">EXPLORE THE WORK</span>{project.links.map(link=><a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<Icon size={14}/></a>)}<a class="text-link" href="/#contact">Discuss this project<Icon name="arrow-right" size={14}/></a></aside>
      <article class="prose"><h2>The problem</h2><p>{project.problem}</p><h2>Why this matters to me</h2><p>{project.motivation}</p>{project.researchQuestion&&<><h2>Research question</h2><p>{project.researchQuestion}</p></>}<h2>My role</h2><p>{project.role}</p>{project.advisor&&<><h2>Research Advisor</h2><p><strong>{project.advisor.name}</strong><br/>{project.advisor.affiliation}</p><p><a class="text-link" href={project.advisor.homepage} target="_blank" rel="noopener noreferrer">Academic homepage <Icon size={13}/></a></p></>}<h2>Technical approach</h2><ol>{project.approach.map(step=><li>{step}</li>)}</ol>
        <h2 id="results">Results & current status</h2>{project.results.length>0&&<div class="metric-grid">{project.results.map(metric=><div class="metric-box"><span class="small-label">{metric.label}</span><strong>{metric.value}</strong><p>{metric.context}</p></div>)}</div>}<p class="evidence-note">{project.evidence}</p><h2>Limitations & open questions</h2><ul>{project.limitations.map(limit=><li>{limit}</li>)}</ul>
        {project.reflection&&<><h2>What I learned</h2><p>{project.reflection.text}</p><p><a href={project.reflection.href}>{project.reflection.linkLabel} →</a></p></>}
        {project.slug==='network-digital-twin'&&<><h2>Under the hood</h2><img src="/images/dt4n-architecture.png" alt="Original DT4N architecture diagram showing six flows through the testbed, Eclipse Ditto, detector, cloud and what-if model" loading="lazy" width="1200" height="800"/><p>Original architecture diagram from the DT4N repository. The diagram and source documentation describe the implemented system.</p></>}
        {project.slug==='cloud-gitops'&&<><h2>The delivery pipeline</h2><img src="/images/gitops-pipeline.png" alt="Original NT548 team diagram of application delivery, GitOps promotion and the observability stack" loading="lazy" width="1200" height="800"/></>}
        <div class="next-work"><a class="text-link" href={overview.href}>← All {overview.label.toLowerCase()}</a><a class="text-link" href={`/work/${next.slug}/`}>Next: {next.shortTitle}<Icon name="arrow-right" size={16}/></a></div>
      </article>
    </div>
  </div>
</BaseLayout>
