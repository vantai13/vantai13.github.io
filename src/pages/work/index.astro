---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import NetworkFigure from '../../components/NetworkFigure.astro';
import { work } from '../../data/work';
---
<BaseLayout title="Research & Projects — Doan Van Tai" description="Selected research and engineering work in network digital twins, adaptive routing, decision-making under uncertainty, and cloud infrastructure.">
  <div class="container page-header"><a class="breadcrumb" href="/">← Home</a><p class="eyebrow">RESEARCH & ENGINEERING</p><h1>Questions, experiments,<br />and working systems.</h1><p class="page-description">A collection of completed projects and ongoing investigations. Each project includes its context, implementation, evidence, and limitations.</p></div>
  <section class="container page-body" aria-label="Research and project collection"><div class="filter-bar" role="group" aria-label="Filter projects"><button class="filter-button" data-filter="all" aria-pressed="true">All work</button><button class="filter-button" data-filter="research" aria-pressed="false">Research</button><button class="filter-button" data-filter="engineering" aria-pressed="false">Engineering</button></div><p class="filter-status" data-filter-status role="status">4 projects shown</p><div class="project-grid">{work.map((project,i)=><article class="project-card" data-project-category={i<2?'research':'engineering'}><a href={`/work/${project.slug}/`} class:list={['project-image',{'cloud-image':project.slug==='cloud-gitops'}]} aria-label={`Read ${project.shortTitle}`}>{project.image?<img src={project.image} alt={project.imageAlt} loading="lazy" width="1200" height="750"/>:<NetworkFigure variant={project.slug==='state-model-regret'?'research':'routing'}/>}<span class="image-link-icon"><Icon/></span></a><div class="project-card-content"><div class="work-meta"><span class="pill">{project.status}</span><span>{project.index}</span></div><h2 style="font-size:29px;margin-top:16px"><a href={`/work/${project.slug}/`}>{project.shortTitle}</a></h2><p>{project.summary}</p><div class="stack-tags">{project.tags.slice(0,3).map(tag=><span>{tag}</span>)}</div><a class="text-link" href={`/work/${project.slug}/`}>Read the project <Icon name="arrow-right" size={16}/></a></div></article>)}</div></section>
</BaseLayout>
