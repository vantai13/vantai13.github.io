---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import NetworkFigure from '../components/NetworkFigure.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import DT4NQuantumCard from '../components/DT4NQuantumCard.astro';
import { profile } from '../data/profile';
import { work } from '../data/work';
const projects = work.filter(item => item.kind === 'engineering');
---
<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title" id="home">
    <div class="hero-content">
      <div class="eyebrow hero-eyebrow"><span class="status-dot"></span> A STUDENT OF NETWORKS & SYSTEMS</div>
      <h1 id="hero-title">Doan Van Tai<span class="name-dot">.</span></h1>
      <p class="hero-statement">Research with curiosity.<br />Engineering with purpose.</p>
      <p class="hero-description">I’m a Computer Networks student and undergraduate researcher at <strong>UIT, VNU-HCM</strong>, interested in how networks can be monitored, modeled, and managed.</p>
      <p class="hero-description">I combine <strong>SDN testbeds and simulation</strong> to study how incomplete network information and imperfect predictive models affect routing decisions.</p>
      <div class="hero-actions"><a class="button button-primary" href="/research/">Explore my research <Icon name="arrow-right" size={18}/></a><a class="text-link" href="/cv/">View CV <Icon size={15}/></a></div>
      <div class="hero-meta"><span><Icon name="pin" size={15}/> Ho Chi Minh City, Vietnam</span><span>UIT · VNU-HCM</span></div>
    </div>
    <figure class="hero-portrait">
      <div class="portrait-frame"><img src="/images/tai-sunset.jpg" alt="Doan Van Tai looking out over the sea at sunset" width="1368" height="1824" fetchpriority="high" decoding="async" /><span class="portrait-corner" aria-hidden="true">↗</span></div>
      <figcaption><span class="tiny-cross" aria-hidden="true">+</span> At the seaside.<span class="portrait-label">PERSONAL PHOTO</span></figcaption>
    </figure>
  </section>

  <div class="availability-band"><div class="container availability-inner"><span><span class="status-dot"></span>{profile.availability}</span><a href="#contact">Contact me <Icon name="arrow-up-right" size={15}/></a></div></div>

  <section class="section container about-section" id="about" aria-labelledby="about-title">
    <div class="section-rail"><span class="section-number">01 / ABOUT</span><span class="rail-line"></span></div>
    <div class="about-grid">
      <h2 id="about-title">About <em>me</em></h2>
      <div class="about-copy"><p>I’m working toward a career as a Research Engineer, connecting experimental research with systems that can be built, tested, and inspected.</p><p>My projects have taken me from network testbeds to reinforcement learning and cloud infrastructure. I want to bring that engineering experience into further research and graduate study.</p><a class="text-link" href="/about/">Read more about me <Icon name="arrow-right" size={16}/></a></div>
    </div>
    <div class="interest-row"><span class="small-label">CURRENT INTERESTS</span><div>{profile.interests.map(interest=><span class="interest-tag">{interest}</span>)}</div></div>
  </section>

  <section class="section research-section" id="research" aria-labelledby="research-title"><div class="container">
    <div class="section-rail"><span class="section-number">02 / RESEARCH</span><span class="rail-line"></span></div>
    <div class="section-heading"><div><h2 id="research-title"><em>Research</em></h2><p>Building network models and studying the decisions made with them.</p></div><a class="text-link" href="/research/">Research overview <Icon name="arrow-right" size={16}/></a></div>
    <DT4NQuantumCard />
    <article class="ongoing-research"><div class="ongoing-number" aria-hidden="true">↗</div><div class="ongoing-copy"><div class="work-meta"><span class="pill pill-outline"><span class="status-dot"></span>Research in progress</span><span>2026 to Present</span></div><h3><a href="/work/state-model-regret/">Better information. Better decisions?</a></h3><p>When does improving state information help a routing decision, and how does its effect depend on the response model? I study these questions through controlled queueing models and simulation.</p><a class="text-link" href="/work/state-model-regret/">Inside State-Model-Regret <Icon name="arrow-right" size={16}/></a></div><div class="ongoing-figure"><NetworkFigure variant="research" /></div></article>
  </div></section>

  <section class="section container" id="projects" aria-labelledby="projects-title">
    <div class="section-rail"><span class="section-number">03 / ENGINEERING</span><span class="rail-line"></span></div>
    <div class="section-heading"><div><h2 id="projects-title">Selected <em>Projects</em></h2><p>Implementations in SDN routing and cloud infrastructure.</p></div><a class="text-link" href="/projects/">All engineering projects <Icon name="arrow-right" size={16}/></a></div>
    <div class="project-grid">{projects.map(project => <ProjectCard project={project} headingLevel={3} />)}</div>
  </section>

  <section class="section experience-section" id="experience" aria-labelledby="experience-title"><div class="container">
    <div class="section-rail"><span class="section-number">04 / EXPERIENCE & EDUCATION</span><span class="rail-line"></span></div>
    <div class="experience-grid"><div class="experience-intro"><h2 id="experience-title">Experience &<br /><em>Education</em></h2><p>Research Intern at UIT InSecLab, alongside undergraduate research in computer networks.</p><a class="text-link" href="/experience/">Experience, education & certification <Icon name="arrow-right" size={16}/></a></div><ExperienceTimeline compact /></div>
  </div></section>

  <section class="section container" id="writing" aria-labelledby="writing-title">
    <div class="section-rail"><span class="section-number">05 / WRITING & NOTES</span><span class="rail-line"></span></div>
    <div class="section-heading"><div><h2 id="writing-title">Writing & <em>Notes</em></h2><p>Notes on my projects and current research questions.</p></div><a class="text-link" href="/writing/">All notes <Icon name="arrow-right" size={16}/></a></div>
    <div class="notes-list"><a class="note-row" href="/writing/from-digital-twins-to-routing-decisions/"><span class="note-category">RESEARCH NOTE</span><div><h3>From Network Digital Twins to Better Routing Decisions</h3><p>How building DT4N connects to my current questions about decision quality.</p></div><span class="note-date">06 NOV 2026</span><Icon size={23}/></a><a class="note-row" href="/writing/digital-twins-as-control-loops/"><span class="note-category">SYSTEMS NOTE</span><div><h3>How the DT4N control loop works</h3><p>Following a command from the dashboard to the testbed and back.</p></div><span class="note-date">06 NOV 2026</span><Icon size={23}/></a><a class="note-row" href="/writing/state-information-and-model-fidelity/"><span class="note-category">RESEARCH QUESTION</span><div><h3>Two kinds of uncertainty in a routing decision</h3><p>Separating what a controller observes from what its model predicts.</p></div><span class="note-date">06 NOV 2026</span><Icon size={23}/></a></div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="container contact-inner"><div><div class="eyebrow">06 / CONTACT</div><h2 id="contact-title">Get in <em>Touch</em></h2><p>I’m open to conversations about networking research, AI for Security, and future research or R&D opportunities.</p><a class="button button-primary" href={`mailto:${profile.email}`}>Send me an email <Icon name="arrow-up-right" size={18}/></a></div><div class="contact-links"><span class="small-label">EMAIL</span><a class="email-link" href={`mailto:${profile.email}`}>{profile.email}<Icon size={18}/></a><button class="copy-button" type="button" data-copy-email={profile.email}><Icon name="copy" size={14}/> Copy email address</button><span class="copy-status" data-copy-status role="status" aria-live="polite"></span><a class="github-link" href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={19}/> GitHub <Icon size={15}/></a><span class="contact-location"><Icon name="pin" size={15}/>{profile.location}</span></div></div></section>
</BaseLayout>
