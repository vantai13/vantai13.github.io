---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import NetworkFigure from '../components/NetworkFigure.astro';
import { profile, experience } from '../data/profile';
import { work } from '../data/work';
const projects = work.filter(item=>['deep-rl-routing','cloud-gitops'].includes(item.slug));
---
<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title" id="home">
    <div class="hero-content">
      <div class="eyebrow hero-eyebrow"><span class="status-dot"></span> A STUDENT OF NETWORKS & SYSTEMS</div>
      <h1 id="hero-title">Doan Van Tai<span class="name-dot">.</span></h1>
      <p class="hero-statement">Research with curiosity.<br />Engineering with purpose.</p>
      <p class="hero-description">I explore <strong>network digital twins</strong>, <strong>learning for networking</strong>, and the decisions that connect models to real systems.</p>
      <div class="hero-actions"><a class="button button-primary" href="#research">Explore my research <Icon name="arrow-right" size={18}/></a><a class="text-link" href="/cv/">View CV <Icon size={15}/></a></div>
      <div class="hero-meta"><span><Icon name="pin" size={15}/> Ho Chi Minh City, Vietnam</span><span>UIT · VNU-HCM</span></div>
    </div>
    <figure class="hero-portrait">
      <div class="portrait-frame"><img src="/images/tai-sunset.jpg" alt="Doan Van Tai looking out over the sea at sunset" width="1368" height="1824" fetchpriority="high" decoding="async" /><span class="portrait-corner" aria-hidden="true">↗</span></div>
      <figcaption><span class="tiny-cross" aria-hidden="true">+</span> A quieter point of view.<span class="portrait-label">BEYOND THE TERMINAL</span></figcaption>
    </figure>
  </section>

  <div class="availability-band"><div class="container availability-inner"><span><span class="status-dot"></span>{profile.availability}</span><a href="#contact">Let’s talk about what’s next <Icon name="arrow-up-right" size={15}/></a></div></div>

  <section class="section container about-section" id="about" aria-labelledby="about-title">
    <div class="section-rail"><span class="section-number">01 / ABOUT</span><span class="rail-line"></span></div>
    <div class="about-grid">
      <h2 id="about-title">Between a question<br />and a working <em>system.</em></h2>
      <div class="about-copy"><p>{profile.bio}</p><p>I’m especially interested in the gap between what a model predicts and what a network actually does. My projects bring together simulation, SDN testbeds, and reproducible evaluation to explore that gap.</p><a class="text-link" href="/about/">A little more about me <Icon name="arrow-right" size={16}/></a></div>
    </div>
    <div class="interest-row"><span class="small-label">CURRENT INTERESTS</span><div>{profile.interests.map(interest=><span class="interest-tag">{interest}</span>)}</div></div>
  </section>

  <section class="section research-section" id="research" aria-labelledby="research-title"><div class="container">
    <div class="section-rail"><span class="section-number">02 / RESEARCH</span><span class="rail-line"></span></div>
    <div class="section-heading"><div><h2 id="research-title">Questions worth <em>building for.</em></h2><p>From network models to decisions, with the experiment in between.</p></div><a class="text-link" href="/work/?filter=research">Research overview <Icon name="arrow-right" size={16}/></a></div>
    <article class="featured-research">
      <a href="/work/network-digital-twin/" class="research-visual" aria-label="Read Network Digital Twin case study"><div class="visual-topline"><span class="mini-dots" aria-hidden="true">● ● ●</span><span>DT4N / NETWORK OBSERVATORY</span><Icon size={16}/></div><img src="/images/dt4n-dashboard.png" alt="Actual DT4N dashboard with network topology and monitoring controls" loading="lazy" width="1398" height="885" /><div class="visual-bottomline"><span class="status-dot"></span> SDN TESTBED ↔ DIGITAL TWIN</div></a>
      <div class="research-details"><div class="work-meta"><span class="pill">Completed project</span><span>2025 — 2026</span></div><h3><a href="/work/network-digital-twin/">A digital twin.<br />A real control loop.</a></h3><p>Building a synchronized model of an SDN network, then using it to observe, explore what-if scenarios, and act on the testbed.</p><div class="research-facts"><div><strong>1.017 s</strong><span>p95 state sync · 30 trials</span></div><div><strong>Two-way</strong><span>Telemetry & control</span></div></div><p class="metric-footnote">From archived testbed experiments; offline results reproduced. <a href="/work/network-digital-twin/#results">Methods & limits ↗</a></p><a class="text-link" href="/work/network-digital-twin/">Read the project <Icon name="arrow-right" size={16}/></a></div>
    </article>
    <article class="ongoing-research"><div class="ongoing-number" aria-hidden="true">↗</div><div class="ongoing-copy"><div class="work-meta"><span class="pill pill-outline"><span class="status-dot"></span>Research in progress</span><span>2026 — Present</span></div><h3><a href="/work/state-model-regret/">Better information. Better decisions?</a></h3><p>Exploring how network state quality and response-model fidelity interact in their effect on routing decision regret.</p><a class="text-link" href="/work/state-model-regret/">Inside State–Model–Regret <Icon name="arrow-right" size={16}/></a></div><div class="ongoing-figure"><NetworkFigure variant="research" /></div></article>
  </div></section>

  <section class="section container" id="projects" aria-labelledby="projects-title">
    <div class="section-rail"><span class="section-number">03 / ENGINEERING</span><span class="rail-line"></span></div>
    <div class="section-heading"><div><h2 id="projects-title">Ideas, put to <em>work.</em></h2><p>Selected projects across learning, networks, and infrastructure.</p></div><a class="text-link" href="/work/">Explore all work <Icon name="arrow-right" size={16}/></a></div>
    <div class="project-grid">{projects.map(project=><article class="project-card"><a class:list={['project-image', {'cloud-image':project.slug==='cloud-gitops'}]} href={`/work/${project.slug}/`} aria-label={`Read ${project.shortTitle}`}>{project.image?<img src={project.image} alt={project.imageAlt} loading="lazy" width="1200" height="750"/>:<NetworkFigure/>}<span class="image-link-icon"><Icon size={20}/></span></a><div class="project-card-content"><div class="work-meta"><span>{project.category}</span><span>2026</span></div><h3><a href={`/work/${project.slug}/`}>{project.shortTitle}</a></h3><p>{project.summary}</p><div class="stack-tags">{project.tags.slice(0,3).map(tag=><span>{tag}</span>)}</div><a class="text-link" href={`/work/${project.slug}/`}>Project details <Icon name="arrow-right" size={16}/></a></div></article>)}</div>
  </section>

  <section class="section experience-section" id="experience" aria-labelledby="experience-title"><div class="container">
    <div class="section-rail"><span class="section-number">04 / EXPERIENCE & EDUCATION</span><span class="rail-line"></span></div>
    <div class="experience-grid"><div class="experience-intro"><h2 id="experience-title">A foundation.<br />An evolving <em>direction.</em></h2><p>Learning through research, building through practice.</p><a class="text-link" href="/cv/">The full picture, in my CV <Icon size={16}/></a></div><div class="timeline">
      {experience.map(item=><article class="timeline-item"><span class="timeline-date">{item.date}</span><h3><a href={item.href}>{item.title}</a></h3><p class="timeline-role">{item.role}</p><p>{item.description}</p><span class="timeline-detail">{item.detail}</span></article>)}
      <article class="timeline-item"><span class="timeline-date">2023 — 2027 / EXPECTED</span><h3>University of Information Technology</h3><p class="timeline-role">VNU-HCM · B.Eng. Computer Networks & Communications</p><p>GPA 3.52 / 4.00 · Final-year undergraduate</p></article>
      <div class="certification"><span class="cert-mark" aria-hidden="true">aws<span>⌣</span></span><div><strong>Solutions Architect — Associate</strong><span>Amazon Web Services · SAA-C03 · 2025</span></div></div>
    </div></div>
  </div></section>

  <section class="section container" id="writing" aria-labelledby="writing-title">
    <div class="section-rail"><span class="section-number">05 / WRITING & NOTES</span><span class="rail-line"></span></div>
    <div class="section-heading"><div><h2 id="writing-title">Making room for <em>reflection.</em></h2><p>Working notes from the projects and questions I’m exploring.</p></div><a class="text-link" href="/writing/">All notes <Icon name="arrow-right" size={16}/></a></div>
    <div class="notes-list"><a class="note-row" href="/writing/digital-twins-as-control-loops/"><span class="note-category">SYSTEMS NOTE</span><div><h3>A network twin is a loop, not just a mirror</h3><p>Observing a network is the beginning. Verifying what changed closes the loop.</p></div><span class="note-date">06 NOV 2026</span><Icon size={23}/></a><a class="note-row" href="/writing/state-information-and-model-fidelity/"><span class="note-category">RESEARCH QUESTION</span><div><h3>Two kinds of uncertainty in a routing decision</h3><p>Separating what a controller observes from what its model predicts.</p></div><span class="note-date">06 NOV 2026</span><Icon size={23}/></a></div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="container contact-inner"><div><div class="eyebrow">06 / WHAT’S NEXT</div><h2 id="contact-title">Good work starts<br />with a <em>conversation.</em></h2><p>I’m interested in Research Intern, Research Assistant, and R&D opportunities in networking and intelligent systems.</p><a class="button button-primary" href={`mailto:${profile.email}`}>Let’s get in touch <Icon name="arrow-up-right" size={18}/></a></div><div class="contact-links"><span class="small-label">SAY HELLO</span><a class="email-link" href={`mailto:${profile.email}`}>{profile.email}<Icon size={18}/></a><button class="copy-button" type="button" data-copy-email={profile.email}><Icon name="copy" size={14}/> Copy email address</button><span class="copy-status" data-copy-status role="status" aria-live="polite"></span><a class="github-link" href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={19}/> GitHub <Icon size={15}/></a><span class="contact-location"><Icon name="pin" size={15}/>{profile.location}</span></div></div></section>
</BaseLayout>
