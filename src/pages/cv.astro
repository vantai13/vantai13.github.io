---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
---
<BaseLayout title="CV — Doan Van Tai" description="Research and engineering CV for Doan Van Tai: education, network digital twin research, SDN routing, cloud projects, and technical skills.">
  <div class="container page-header"><a class="breadcrumb" href="/">← Home</a><p class="eyebrow">CURRICULUM VITAE</p><h1>Research & engineering CV.</h1><p class="page-description">A concise view of my education, research, and technical work.</p><div class="cv-actions"><a class="button button-primary" href="/files/DoanVanTai_CV.pdf" download>Download PDF <Icon name="download" size={17}/></a><button class="button button-secondary" type="button" id="print-cv">Print this CV</button></div></div>
  <div class="container"><article class="cv-document"><header class="cv-print-header"><h1>Doan Van Tai</h1><p>UIT–VNUHCM · Ho Chi Minh City, Vietnam<br/>{profile.email} · github.com/vantai13 · vantai13.github.io</p></header>
    <section><h2>Profile</h2><p>Final-year Computer Networks and Communications student at UIT–VNUHCM, working toward a career as a Research Engineer. Experience building an SDN network digital twin, a deep reinforcement learning routing agent, and cloud delivery infrastructure. Interested in research and R&D opportunities in networking and intelligent systems.</p></section>
    <section><h2>Education</h2><div class="cv-section-heading"><h3>University of Information Technology, VNU-HCM</h3><span>2023 — 2027 (expected)</span></div><p>B.Eng. in Computer Networks and Communications · GPA 3.52 / 4.00</p></section>
    <section><h2>Research Experience</h2><div class="cv-section-heading"><h3>Network Digital Twin Research — Project Lead</h3><span>2025 — 2026</span></div><p>UIT-supported undergraduate research · Advised by Dr. Huynh Van Dang</p><ul><li>Built a Mininet / Ryu testbed synchronized bidirectionally with Eclipse Ditto; archived experiments measured upward sync p95 at 1.017 s over 30 trials.</li><li>Implemented anomaly detection, what-if analysis, and closed-loop mitigation. The stored controller A/B study measured h3 throughput at 0.295 Mbps OFF versus 2.146 Mbps ON under UDP flood (32 trials, 8 blocks).</li><li>Preserved experiment artifacts and offline reproduction scripts. Detector limitations and the what-if operating region are documented in the project.</li></ul><div class="cv-section-heading"><h3>State–Model–Regret for Network Routing</h3><span>2026 — Present</span></div><p>Ongoing research into the effects of current-state information and action-response model fidelity on expected routing decision regret. Explores uncertainty, stale telemetry, queueing systems, and counterfactual decision-making. This is exploratory work, not a claimed publication or confirmed contribution.</p></section>
    <section><h2>Selected Engineering Projects</h2><h3>Deep Reinforcement Learning for SDN Routing</h3><p>PyTorch · Gymnasium · Mininet · Ryu · Vue / Flask</p><ul><li>Implemented Dueling / Double DQN with prioritized replay, an 81-dimensional state, action masking, and curriculum learning.</li><li>Connected the agent to an SDN testbed and an OSPF comparison pipeline across congestion and failure scenarios.</li></ul><h3>Cloud Infrastructure & GitOps on AWS — Team Project</h3><p>Terraform · EKS · GitHub Actions · ArgoCD · Prometheus</p><ul><li>Contributed infrastructure as code and GitOps delivery for a three-tier application, with Blue/Green rollout analysis, observability, and security controls.</li></ul></section>
    <section><h2>Technical Skills</h2>{profile.skills.map(group=><p><strong>{group.title}:</strong> {group.items}</p>)}</section>
    <section><h2>Certification</h2><p>AWS Certified Solutions Architect – Associate (SAA-C03), 2025.</p></section>
  </article></div>
  <script>document.querySelector('#print-cv')?.addEventListener('click',()=>window.print());</script>
</BaseLayout>
